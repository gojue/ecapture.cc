diff --git a/src/vitepress/components/VPLocalNavBarSearch.vue b/src/vitepress/components/VPLocalNavBarSearch.vue
new file mode 100644
--- /dev/null
+++ b/src/vitepress/components/VPLocalNavBarSearch.vue
@@ -0,0 +1,63 @@
+<script lang="ts" setup>
+import 'vitepress/dist/client/theme-default/styles/icons.css'
+import { defineAsyncComponent, onMounted, onUnmounted, ref } from 'vue'
+import { useConfig } from '../composables/config'
+
+const { config } = useConfig()
+const searchOpen = ref(false)
+const VPLocalSearchBox = defineAsyncComponent(
+  () => import('vitepress/dist/client/theme-default/components/VPLocalSearchBox.vue')
+)
+
+function handleSearchHotKey(event: KeyboardEvent) {
+  if (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey)) {
+    event.preventDefault()
+    openSearch()
+  }
+}
+
+function openSearch() {
+  if (searchOpen.value) return
+  const scrollbarWidth = Math.max(0, window.innerWidth - document.documentElement.clientWidth)
+  document.body.style.setProperty('--vp-local-search-scrollbar-width', `${scrollbarWidth}px`)
+  document.body.classList.add('vp-local-search-open')
+  searchOpen.value = true
+}
+
+function closeSearch() {
+  searchOpen.value = false
+  document.body.classList.remove('vp-local-search-open')
+  document.body.style.removeProperty('--vp-local-search-scrollbar-width')
+}
+
+onMounted(() => {
+  window.addEventListener('keydown', handleSearchHotKey)
+})
+
+onUnmounted(() => {
+  window.removeEventListener('keydown', handleSearchHotKey)
+  document.body.classList.remove('vp-local-search-open')
+  document.body.style.removeProperty('--vp-local-search-scrollbar-width')
+})
+</script>
+
+<template>
+  <div v-if="config.search?.provider === 'local'" class="VPNavBarSearch">
+    <VPLocalSearchBox v-if="searchOpen" @close="closeSearch" />
+    <button
+      type="button"
+      class="VPLocalSearchButton"
+      :aria-label="config.i18n?.search ?? 'Search'"
+      @click="openSearch"
+    >
+      <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
+        <path
+          d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9419-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z"
+          stroke="currentColor"
+          stroke-linecap="round"
+          stroke-linejoin="round"
+        />
+      </svg>
+    </button>
+  </div>
+</template>
